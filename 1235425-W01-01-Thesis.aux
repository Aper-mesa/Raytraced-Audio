\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}Figures}{25}{subsection.4.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Grouped bar chart showing normalized metric values across all five degradation conditions. The ``LSD blindspot'' is annotated: the minimum-phase condition has near-zero LSD but the highest group delay error and CPM of all conditions.}}{25}{figure.1}\protected@file@percent }
\newlabel{fig:metric_comparison}{{1}{25}{Grouped bar chart showing normalized metric values across all five degradation conditions. The ``LSD blindspot'' is annotated: the minimum-phase condition has near-zero LSD but the highest group delay error and CPM of all conditions}{figure.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.6}Discussion}{25}{subsection.4.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Scatter plot of LSD vs.\ CPM for each degradation condition. The minimum-phase condition (lower-left corner by LSD, upper region by CPM) demonstrates the fundamental divergence between magnitude-only and composite perceptual metrics. The dashed diagonal represents hypothetical LSD--CPM agreement.}}{26}{figure.2}\protected@file@percent }
\newlabel{fig:lsd_vs_cpm}{{2}{26}{Scatter plot of LSD vs.\ CPM for each degradation condition. The minimum-phase condition (lower-left corner by LSD, upper region by CPM) demonstrates the fundamental divergence between magnitude-only and composite perceptual metrics. The dashed diagonal represents hypothetical LSD--CPM agreement}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Spectral comparison of original vs.\ minimum-phase HRTF (Subject~1, left ear, averaged over 20 spatial directions). Top: Magnitude spectra are nearly identical, explaining the near-zero LSD. Bottom: The magnitude difference is minimal across the entire frequency range, including the pinna notch region (4--12~kHz, shaded). This visual confirms that LSD, which operates solely on magnitude, is fundamentally incapable of detecting the phase distortion introduced by minimum-phase reconstruction.}}{27}{figure.3}\protected@file@percent }
\newlabel{fig:spectral_comparison}{{3}{27}{Spectral comparison of original vs.\ minimum-phase HRTF (Subject~1, left ear, averaged over 20 spatial directions). Top: Magnitude spectra are nearly identical, explaining the near-zero LSD. Bottom: The magnitude difference is minimal across the entire frequency range, including the pinna notch region (4--12~kHz, shaded). This visual confirms that LSD, which operates solely on magnitude, is fundamentally incapable of detecting the phase distortion introduced by minimum-phase reconstruction}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Group delay comparison of original vs.\ minimum-phase HRTF (Subject~1, left ear, averaged over 20 spatial directions). The massive divergence between the two curves---particularly in the 4--12~kHz pinna notch region (shaded)---reveals the phase distortion that LSD is blind to. The group delay error metric (GD Err) captures this divergence, driving the minimum-phase condition's high CPM score.}}{27}{figure.4}\protected@file@percent }
\newlabel{fig:group_delay}{{4}{27}{Group delay comparison of original vs.\ minimum-phase HRTF (Subject~1, left ear, averaged over 20 spatial directions). The massive divergence between the two curves---particularly in the 4--12~kHz pinna notch region (shaded)---reveals the phase distortion that LSD is blind to. The group delay error metric (GD Err) captures this divergence, driving the minimum-phase condition's high CPM score}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Individual metric responses across all five degradation conditions (error bars represent $\pm 1$ standard deviation across 20 subjects). Each panel isolates one metric, revealing the distinct sensitivity profiles: LSD responds strongly to magnitude smoothing but is near-zero for minimum-phase; conversely, group delay error peaks for minimum-phase while remaining low for smoothing and quantization conditions.}}{28}{figure.5}\protected@file@percent }
\newlabel{fig:individual_metrics}{{5}{28}{Individual metric responses across all five degradation conditions (error bars represent $\pm 1$ standard deviation across 20 subjects). Each panel isolates one metric, revealing the distinct sensitivity profiles: LSD responds strongly to magnitude smoothing but is near-zero for minimum-phase; conversely, group delay error peaks for minimum-phase while remaining low for smoothing and quantization conditions}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Radar chart of normalised metric profiles per degradation condition. Each axis represents one metric normalised to [0,\,1]. The minimum-phase condition (blue) shows a dramatically different profile from all other conditions, extending along the GD Error and ITD Error axes while collapsing on the LSD and ILD Error axes. This visualisation highlights the complementary nature of the four metrics and the necessity of a composite approach.}}{29}{figure.6}\protected@file@percent }
\newlabel{fig:radar_chart}{{6}{29}{Radar chart of normalised metric profiles per degradation condition. Each axis represents one metric normalised to [0,\,1]. The minimum-phase condition (blue) shows a dramatically different profile from all other conditions, extending along the GD Error and ITD Error axes while collapsing on the LSD and ILD Error axes. This visualisation highlights the complementary nature of the four metrics and the necessity of a composite approach}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Stacked bar chart showing the contribution of each CPM component to the total composite score. For the minimum-phase condition, the group delay component (green) accounts for over 95\% of the total CPM, while for the smoothing and quantization conditions, the score is distributed across LSD and ILD components. This decomposition reveals precisely which perceptual dimensions are degraded by each processing technique.}}{30}{figure.7}\protected@file@percent }
\newlabel{fig:cpm_breakdown}{{7}{30}{Stacked bar chart showing the contribution of each CPM component to the total composite score. For the minimum-phase condition, the group delay component (green) accounts for over 95\% of the total CPM, while for the smoothing and quantization conditions, the score is distributed across LSD and ILD components. This decomposition reveals precisely which perceptual dimensions are degraded by each processing technique}{figure.7}{}}
